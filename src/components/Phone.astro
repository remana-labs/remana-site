---
/** A phone frame around a 720×1544 screenshot. Pure CSS: no device image to license or re-export. */
interface Props { src: string; alt: string; width?: number; eager?: boolean }
const { src, alt, width = 300, eager = false } = Astro.props;
---
<figure class="phone" style={`--w:${width}px`}>
  <img src={src} width="720" height="1544" alt={alt} loading={eager ? "eager" : "lazy"} decoding="async" />
</figure>
<style>
  .phone { margin: 0; width: var(--w); max-width: 100%; aspect-ratio: 720 / 1544; padding: 10px; border-radius: 40px;
    background: var(--color-surface-container-highest-dark); border: 1px solid rgb(255 255 255 / .12); box-shadow: var(--shadow); position: relative; }
  .phone::after { content: ""; position: absolute; top: 18px; left: 50%; translate: -50% 0; width: 22%; height: 18px; border-radius: 999px; background: #000; opacity: .9; }
  .phone img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 30px; background: #0B0D0E; }
</style>
