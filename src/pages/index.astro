---
import Base from "../layouts/Base.astro";
import BrandMark from "../components/BrandMark.astro";
import ProvenanceExample from "../components/ProvenanceExample.astro";
---
<Base title="remana" description="A meeting memory that knows what was said, and what it only inferred.">
  <section class="hero">
    <BrandMark height={56} />
    <h1>A meeting memory that knows what was said — and what it only inferred.</h1>
    <p>Record a meeting on your phone. Remana turns it into memory — the facts, the commitments, the open questions, per person — and marks every one of them: <strong>said</strong>, or <strong>inferred</strong>. Your memory stays on your phone. The cloud only does the listening.</p>
    <div id="waitlist"></div>
    <p class="meta">Android first · iOS later</p>
  </section>
  <ProvenanceExample />
  <section aria-labelledby="screens-h">
    <h2 id="screens-h">On your phone</h2>
    <div class="screens">
      <img src="/screens/home.png" width="360" height="772" alt="Home: the next meeting and open commitments" loading="lazy" />
      <img src="/screens/meeting.png" width="360" height="772" alt="A meeting's facts, each with a said-or-inferred mark" loading="lazy" />
      <img src="/screens/meetings.png" width="360" height="772" alt="Meetings: every recording, with who still needs a name" loading="lazy" />
    </div>
  </section>
</Base>
<style>
  .hero { padding-block: var(--space-xxxl) var(--space-xl); display: grid; gap: var(--space-lg); }
  .hero p { font-size: 1.125rem; } .meta { color: var(--ink-2); font-size: 0.875rem; }
  .screens { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--space-lg); }
  .screens img { width: 100%; height: auto; border-radius: var(--radius-lg); border: 1px solid var(--line); }
</style>
